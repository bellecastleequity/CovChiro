{
  "name": "coverage-marketplace",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm --filter @cm/web dev",
    "dev:worker": "pnpm --filter @cm/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @cm/core test && pnpm --filter @cm/tests test",
    "test:core": "pnpm --filter @cm/core test",
    "test:invariants": "pnpm --filter @cm/tests test",
    "db:generate": "pnpm --filter @cm/db generate",
    "db:migrate": "pnpm --filter @cm/db migrate:deploy",
    "db:seed": "pnpm --filter @cm/db seed",
    "db:reset": "pnpm --filter @cm/db reset"
  }
}
