{
  "name": "@cm/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "seed": "tsx prisma/seed.ts",
    "reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@cm/config": "workspace:*",
    "@cm/core": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@types/node": "^22",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
