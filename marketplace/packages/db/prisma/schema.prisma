  kind         String
  title        String
  entityType   String?
  entityId     String?
  resolvedAt   DateTime? @db.Timestamptz(3)
  resolvedById String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([resolvedAt, createdAt])
}

// ============================ Smart Dispatch & On Call (Addendum 02) ============================

enum UrgencyTier {
  SAME_DAY
  SHORT
  NEAR
  PLANNED
}

enum DispatchTrigger {
  URGENT_POST
  SELECTION_DEADLINE
  BACKFILL
  CLINIC_REQUEST
  ADMIN
  RATE_BOOST
}

enum DispatchStatus {
  ACTIVE
  FILLED
  EXHAUSTED
  CANCELLED
}

enum DispatchStage {
  STANDBY
  ON_CALL_CHECK
  WAVES
  BROADCAST
  DONE
}

model Dispatch {
  id               String           @id @default(cuid())
  shiftId          String
  shift            Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  trigger          DispatchTrigger
  status           DispatchStatus   @default(ACTIVE)
  tierAtStart      UrgencyTier
  currentWave      Int              @default(0)
  stage            DispatchStage    @default(ON_CALL_CHECK)
  /// Standby window (backfill) end, when stage = STANDBY.
  stageEndsAt      DateTime?        @db.Timestamptz(3)
  bestMatchAtStart Float?
  startedAt        DateTime         @default(now()) @db.Timestamptz(3)
  endedAt          DateTime?        @db.Timestamptz(3)
  filledOfferId    String?
  filledVia        SelectionMethod?
  filledProviderId String?
  waves            Wave[]
  offers           Offer[]

  @@index([shiftId, status])
  @@index([status, stage])
}

model Wave {
  id           String      @id @default(cuid())
  dispatchId   String
  dispatch     Dispatch    @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  number       Int
  isBroadcast  Boolean     @default(false)
  isStandby    Boolean     @default(false)
  tier         UrgencyTier
  sentAt       DateTime    @db.Timestamptz(3)
  windowEndsAt DateTime    @db.Timestamptz(3)
  holdEndsAt   DateTime?   @db.Timestamptz(3)
  closedAt     DateTime?   @db.Timestamptz(3)
  offers       Offer[]

  @@unique([dispatchId, number])
  @@index([closedAt, windowEndsAt])
}

model OnCallRule {
  id                 String    @id @default(cuid())
  providerId         String
  provider           Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  active             Boolean   @default(true)
  professionCodes    String[]
  /// [{ weekday, startMin, endMin }]
  recurringWindows   Json      @default("[]")
  /// [{ startsAt, endsAt }]
  dateWindows        Json      @default("[]")
  timeZone           String
  maxDriveMinutes    Int
  minPayHalfDayCents Int?
  minPayFullDayCents Int?
  minPayHourlyCents  Int?
  minNoticeMinutes   Int       @default(90)
  maxPerDay          Int       @default(1)
  maxPerWeek         Int       @default(5)
  favoritesOnly      Boolean   @default(false)
  minClinicRating    Float?
  excludedClinicIds  String[]  @default([])
  allowOvernight     Boolean   @default(false)
  pausedUntil        DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  @@index([providerId, active])
}

model ProviderResponsiveness {
  providerId            String
  provider              Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tier                  UrgencyTier
  offers                Float
  hits                  Float
  pRespond              Float
  medianResponseSeconds Int?
  updatedAt             DateTime    @updatedAt @db.Timestamptz(3)

  @@id([providerId, tier])
}

model StandbyEntry {
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  matchScore Float
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([shiftId, providerId])
}

/// One row per booking-digest email sent ("daily:<providerId>:<local date>",
/// "weekly:<providerId>:<week start>"), claimed before sending so repeated
/// cron ticks never send a digest twice.
model DigestSend {
  key    String   @id
  userId String
  sentAt DateTime @default(now()) @db.Timestamptz(3)
}

/// Private post-shift feedback from a clinic to a provider. Only the provider
/// sees it; it never affects ratings, badges, matching or the public profile.
model ProviderFeedback {
  id           String    @id @default(cuid())
  assignmentId String    @unique
  providerId   String
  clinicOrgId  String
  authorUserId String
  body         String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  readAt       DateTime? @db.Timestamptz(3)

  @@index([providerId, createdAt])
}

// ============================ growth: AI marketing & marketplace activation ============================
// Software decides who is contacted, when, and whether they're eligible; AI
// only writes, classifies and summarizes inside those decisions. See
// packages/services/src/growth/.

/// Strategic launch regions; "ready" when enough coverage-ready providers sit inside the radius.
model GrowthMarket {
  id              String    @id @default(cuid())
  key             String    @unique
  name            String
  state           String    @db.Char(2)
  professionCode  String    @default("DC")
  centerLat       Float
  centerLng       Float
  radiusMiles     Int       @default(60)
  targetProviders Int       @default(5)
  priority        Int       @default(100)
  active          Boolean   @default(true)
  notes           String?
  /// Supply Gap agent: CRITICAL | LOW | BUILDING | HEALTHY | LIQUID (core supplyStatus), refreshed hourly.
  supplyStatus    String?
  supplyCheckedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
}

enum ProspectStage {
  PROSPECT
  CONTACTABLE
  OUTREACH_STARTED
  ENGAGED
  INTERESTED
  ACCOUNT_STARTED
  ACCOUNT_CREATED
  COVERAGE_REQUESTED
  FIRST_SHIFT_BOOKED
  FIRST_SHIFT_COMPLETED
  REPEAT_CLINIC
  DORMANT
  NOT_INTERESTED
  DO_NOT_CONTACT
}

enum IntentCategory {
  COLD
  WARM
  ENGAGED
  HIGH_INTENT
  ACTIVE_CUSTOMER
  REPEAT_CUSTOMER
}

/// Clinic prospect CRM: one row per practice, public business information only.
/// clinicOrgId links it once the practice has an account.
model ClinicProspect {
  id                 String         @id @default(cuid())
  /// Professions practising at this location (from the registry search that found it). Outreach uses the first one with a LIVE growth target here.
  professionCodes    String[]       @default(["DC"])
  clinicName         String
  ownerName          String?
  doctors            String[]       @default([])
  email              String?        @db.Citext
  phone              String?
  website            String?
  address            String?
  city               String?
  county             String?
  state              String         @default("FL") @db.Char(2)
  zip                String?
  lat                Float?
  lng                Float?
  marketKey          String?
  locationsCount     Int?
  providerCount      Int?
  practiceType       String?
  /// independent | group | franchise | unknown
  ownership          String?
  multidisciplinary  Boolean?
  hasContactForm     Boolean?
  socialUrls         String[]       @default([])
  source             String?
  collectedAt        DateTime?      @db.Timestamptz(3)
  verifiedAt         DateTime?      @db.Timestamptz(3)
  /// solo | multi_dc | multi_location | franchise | multidisciplinary | high_volume | specialty | unknown
  segment            String         @default("unknown")
  segmentConfidence  Float?
  /// NONE | RULE | AI | MANUAL — an AI guess is never shown as fact.
  segmentBasis       String         @default("NONE")
  segmentReason      String?
  stage              ProspectStage  @default(PROSPECT)
  intentScore        Int            @default(0)
  intentCategory     IntentCategory @default(COLD)
  clinicOrgId        String?        @unique
  /// UNKNOWN | VALID | BOUNCED | COMPLAINED | UNSUBSCRIBED
  emailStatus        String         @default("UNKNOWN")
  smsConsentAt       DateTime?      @db.Timestamptz(3)
  doNotContact       Boolean        @default(false)
  outreachStep       Int            @default(0)
  outreachPaused     Boolean        @default(false)
  lastContactedAt    DateTime?      @db.Timestamptz(3)
  lastInboundAt      DateTime?      @db.Timestamptz(3)
  objections         String[]       @default([])
  aiSummary          String?
  notes              String?
  campaignCode       String?
  /// Automatic prospecting: normalized practice address (dedupe) and the NPPES NPIs seen there.
  addressKey         String?        @unique
  npis               String[]       @default([])
  /// The name is a doctor's name from the registry; research may replace it with the practice name.
  nameFromRegistry   Boolean        @default(false)
  /// PENDING | RUNNING | DONE | NOT_FOUND | FAILED
  researchStatus     String         @default("PENDING")
  researchAttempts   Int            @default(0)
  researchedAt       DateTime?      @db.Timestamptz(3)
  researchConfidence Float?
  /// Pages the AI research cited for this record.
  sourceUrls         String[]       @default([])
  /// Unsubscribe and tracked-link token.
  publicToken        String         @unique
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)

  @@index([stage])
  @@index([researchStatus])
  @@index([marketKey])
  @@index([intentScore])
  @@index([email])
}

/// Campaign links: /join/<code> (providers, e.g. schools) and clinic campaigns. QR codes encode the link.
model GrowthCampaign {
  id             String    @id @default(cuid())
  code           String    @unique
  audience       PartyType @default(PROVIDER)
  /// school | event | ads | social | email | referral | other
  kind           String    @default("school")
  name           String
  schoolName     String?
  professionCode String    @default("DC")
  headline       String?
  body           String?
  spendCents     Int       @default(0)
  /// Where it runs, e.g. "Jacksonville, FL" (display and reporting).
  geography      String?
  visits         Int       @default(0)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
}

/// Checked in code before every growth send; no agent can override it.
model CommSuppression {
  id        String   @id @default(cuid())
  /// EMAIL | SMS | ALL
  channel   String
  /// Lower-case email or E.164 phone.
  address   String   @db.Citext
  /// UNSUBSCRIBE | BOUNCE | COMPLAINT | MANUAL | DO_NOT_CONTACT | SMS_STOP
  reason    String
  source    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([channel, address])
}

/// Every growth message in or out, including blocked and pending-approval ones.
model Communication {
  id            String   @id @default(cuid())
  /// PROSPECT | PROVIDER | CLINIC
  entityType    String
  entityId      String
  /// EMAIL | SMS | CHAT | PHONE | NOTE
  channel       String
  /// OUT | IN
  direction     String   @default("OUT")
  agent         String?
  /// COMMERCIAL | RELATIONSHIP | TRANSACTIONAL | CONVERSATIONAL
  purpose       String
  promptKey     String?
  promptVersion Int?
  toAddress     String?
  subject       String?
  body          String?
  /// SENT | FAILED | BLOCKED | PENDING_APPROVAL | APPROVED | REJECTED | RECEIVED | LOGGED
  status        String
  blockReason   String?
  error         String?
  /// One message per (entity, step): makes every sweep idempotent.
  dedupeKey     String?  @unique
  createdById   String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([status, createdAt])
  @@index([promptKey, promptVersion])
}

enum PromptStatus {
  DRAFT
  APPROVED
  RETIRED
}

/// Centralized, versioned message templates. body is the approved text (sent
/// verbatim when AI is off or its output fails the guardrails); instructions
/// let AI personalize within it. Saving creates a new DRAFT version.
model PromptTemplate {
  id              String       @id @default(cuid())
  key             String
  /// Profession this wording is for; null = any profession. A profession-specific version wins over a generic one.
  professionCode  String?
  version         Int
  agent           String
  channel         String       @default("EMAIL")
  purpose         String
  subjectTemplate String?
  body            String
  instructions    String?
  allowedVars     String[]     @default([])
  abWeight        Int          @default(100)
  status          PromptStatus @default(DRAFT)
  active          Boolean      @default(false)
  approvedById    String?
  approvedAt      DateTime?    @db.Timestamptz(3)
  notes           String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([key, version])
}

/// Approved knowledge the conversation agent may answer from.
model KbArticle {
  id             String   @id @default(cuid())
  /// null = every profession.
  professionCode String?
  topic          String
  /// CLINIC | PROVIDER | ALL
  audience       String   @default("ALL")
  question       String
  answer         String
  keywords       String[] @default([])
  approved       Boolean  @default(false)
  active         Boolean  @default(true)
  updatedById    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

enum EscalationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

/// "A person should handle this": legal/payment/safety questions, high intent,
/// low AI confidence, explicit requests for a human.
model Escalation {
  id                String           @id @default(cuid())
  entityType        String
  entityId          String?
  entityLabel       String
  reasonCode        String
  reason            String
  intentLevel       String?
  summary           String?
  recommendedAction String?
  history           Json?
  status            EscalationStatus @default(OPEN)
  /// Set when filed in the Spam folder: solicitation | spam (filed RESOLVED, no notification).
  spamCategory      String?
  spamReasons       String[]         @default([])
  resolution        String?
  resolvedById      String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  resolvedAt        DateTime?        @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([entityType, entityId])
  @@index([spamCategory, createdAt])
}

/// Senders whose public-form messages go straight to the Spam folder (email address or whole domain).
model BlockedSender {
  id          String   @id @default(cuid())
  /// EMAIL | DOMAIN
  kind        String
  value       String   @unique @db.Citext
  reason      String?
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

/// Audit log of every agent action (what it saw by reference, prompt version, model, output).
model AgentActivity {
  id              String   @id @default(cuid())
  agent           String
  action          String
  entityType      String?
  entityId        String?
  trigger         String?
  contextRef      String?
  promptKey       String?
  promptVersion   Int?
  model           String?
  output          String?
  channel         String?
  sendStatus      String?
  humanOverrideBy String?
  error           String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([agent, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// AI spend. Cost is in micro-dollars (1/1,000,000 USD) because single calls cost fractions of a cent.
model AiUsage {
  id           String   @id @default(cuid())
  agent        String
  task         String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costMicroUsd Int      @default(0)
  ok           Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

/// Lead-scoring signals (replies, calculator use, dates entered...). Opens are deliberately not a signal.
model LeadSignal {
  id         String   @id @default(cuid())
  /// PROSPECT | PROVIDER
  entityType String
  entityId   String
  kind       String
  meta       Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
}

/// Emails of banned accounts: signup refuses them. Removed when an admin reinstates the account.
model BannedEmail {
  email       String   @id @db.Citext
  reason      String?
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

/// Schools shown in the student sign-up dropdown, per profession. Built-in lists are added
/// when a profession goes active (or into Growth prelaunch); admins add or hide the rest.
model School {
  id             String   @id @default(cuid())
  professionCode String
  name           String
  city           String?
  state          String?  @db.Char(2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([professionCode, name])
}

/// Growth expansion: one row per profession × state (Admin → Growth → Expansion).
/// OFF: nothing. PRELAUNCH: registry discovery + web research of clinics, and provider
/// welcome/credential/activation emails; no clinic outreach. LIVE: clinic outreach too, but only
/// while the marketplace has the profession enabled in that state (StateConfig + ProfessionStateConfig).
model GrowthTarget {
  id              String    @id @default(cuid())
  professionCode  String
  state           String    @db.Char(2)
  /// OFF | PRELAUNCH | LIVE
  status          String    @default("OFF")
  /// Cities searched in the NPI registry, rotating a few per run.
  cities          String[]  @default([])
  notes           String?
  statusChangedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([professionCode, state])
}

/// Growth settings per profession: how to find its practices in the NPI registry and how to name them.
model GrowthProfession {
  professionCode String   @id
  /// NPPES taxonomy_description search term, e.g. "Chiropractor". Blank = discovery skipped.
  registrySearch String   @default("")
  /// NPI taxonomy code prefixes that count as this profession, e.g. 111N.
  taxonomyCodes  String[] @default([])
  /// e.g. "chiropractic practice", "physical therapy clinic".
  practiceNoun   String   @default("practice")
  /// Credential after a sole practitioner's name, e.g. "D.C.", "PT".
  nameSuffix     String   @default("")
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

// ---------- Blog (AI-drafted, human-published) ----------

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Public blog post. AI may draft; only an admin publishes, and only when core
/// checkBlogPost has no errors. Body is a safe Markdown subset (core blog.ts).
model BlogPost {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  /// Meta description for search results.
  description   String
  body          String
  /// CLINIC | PROVIDER | ALL
  audience      String     @default("ALL")
  keywords      String[]   @default([])
  status        BlogStatus @default(DRAFT)
  aiGenerated   Boolean    @default(false)
  aiModel       String?
  /// The topic or brief the draft was written from.
  brief         String?
  authorName    String?
  createdById   String?
  publishedById String?
  publishedAt   DateTime?  @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  @@index([status, publishedAt])
}

/// A licensed provider found in the public NPI registry who isn't on the platform yet.
/// Contact discovery looks for a professional email that reaches them (core acceptProviderEmail);
/// recruitment emails go out only in PRELAUNCH/LIVE growth markets, through the compliance gate.
model ProviderProspect {
  id                   String    @id @default(cuid())
  npi                  String    @unique
  professionCode       String
  firstName            String?
  lastName             String?
  credential           String?
  displayName          String
  address              String?
  city                 String?
  state                String    @db.Char(2)
  zip                  String?
  addressKey           String?
  lat                  Float?
  lng                  Float?
  marketKey            String?
  /// The practice location (clinic prospect) at the same address, if any.
  clinicProspectId     String?
  providersAtPractice  Int       @default(1)
  /// OWNER | ASSOCIATE | UNKNOWN
  practiceRole         String    @default("UNKNOWN")
  source               String    @default("NPPES NPI registry")
  collectedAt          DateTime  @default(now()) @db.Timestamptz(3)
  /// PENDING | RUNNING | DONE | NOT_FOUND | AMBIGUOUS | FAILED | SKIPPED
  researchStatus       String    @default("PENDING")
  researchAttempts     Int       @default(0)
  researchedAt         DateTime? @db.Timestamptz(3)
  researchConfidence   Float?
  researchCostMicroUsd Int       @default(0)
  website              String?
  email                String?   @db.Citext
  emailSourceUrl       String?
  /// How the email was found: practice (from the researched clinic) | research | manual
  emailOrigin          String?
  /// NONE | FOUND | VERIFIED | INVALID
  contactStatus        String    @default("NONE")
  emailVerifiedAt      DateTime? @db.Timestamptz(3)
  emailCheck           String?
  /// VALID | BOUNCED | COMPLAINED | UNSUBSCRIBED
  emailStatus          String    @default("VALID")
  sourceUrls           String[]  @default([])
  /// DISCOVERED | CONTACT_FOUND | CONTACT_VERIFIED | CONTACTED | ENGAGED | REGISTERED | NOT_INTERESTED | DO_NOT_CONTACT
  stage                String    @default("DISCOVERED")
  needsReview          Boolean   @default(false)
  reviewReason         String?
  outreachStep         Int       @default(0)
  lastContactedAt      DateTime? @db.Timestamptz(3)
  lastInboundAt        DateTime? @db.Timestamptz(3)
  outreachPaused       Boolean   @default(false)
  doNotContact         Boolean   @default(false)
  campaignCode         String?
  /// Set when they register (tracked link, same email or same NPI).
  providerId           String?   @unique
  registeredAt         DateTime? @db.Timestamptz(3)
  publicToken          String    @unique
  notes                String?
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  @@index([stage])
  @@index([professionCode, state])
  @@index([researchStatus])
  @@index([marketKey])
  @@index([addressKey])
}

/// Acquisition costs other than AI (which is logged per call in AiUsage): search APIs, business data,
/// email enrichment/verification/delivery, SMS, advertising, referral incentives. Entered by admins.
model GrowthCost {
  id           String   @id @default(cuid())
  /// First day of the month the cost belongs to.
  month        DateTime @db.Date
  /// SEARCH_API | BUSINESS_DATA | EMAIL_ENRICHMENT | EMAIL_VERIFICATION | EMAIL_DELIVERY | SMS | ADVERTISING | AI_OTHER | REFERRAL_INCENTIVES | OTHER
  category     String
  /// PROVIDER | CLINIC | BOTH
  audience     String   @default("BOTH")
  amountCents  Int
  campaignCode String?
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([month])
}

/// One Stripe transfer within a provider payment. A leg linked to a clinic charge (paymentId)
/// uses Stripe source_transaction, so those funds are reserved for the provider and never paid
/// out to the platform; an unlinked leg comes from the platform balance (bonuses, adjustments).
/// Retries only re-send legs that aren't PAID, with the same idempotency key.
model PayoutTransferLeg {
  id               String         @id @default(cuid())
  transferId       String
  transfer         PayoutTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  paymentId        String?
  amountCents      Int
  idempotencyKey   String         @unique
  stripeTransferId String?        @unique
  /// PENDING | PAID | FAILED
  status           String         @default("PENDING")
  failureReason    String?
  paidAt           DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)

  @@index([transferId])
  @@index([paymentId])
}

/// Database backups: nightly encrypted exports (EXPORT), Neon restore points (SNAPSHOT) and restores (RESTORE).
model BackupRun {
  id           String    @id @default(cuid())
  /// EXPORT | SNAPSHOT | RESTORE
  kind         String
  /// RUNNING | DONE | FAILED | DELETED
  status       String    @default("RUNNING")
  label        String?
  /// daily | weekly | monthly | manual | before-restore
  tier         String?
  storageKey   String?
  sizeBytes    Int?
  rowCount     Int?
  tables       Json?
  neonBranchId String?
  restoredTo   DateTime? @db.Timestamptz(3)
  error        String?
  createdById  String?
  startedAt    DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime? @db.Timestamptz(3)

  @@index([kind, startedAt])
}

/// Browser / phone push subscription (Web Push). Pushes carry no data: the device fetches its latest notification.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)

  @@index([userId])
}

// ============================ volume pricing (Addendum 03) ============================

enum VolumeTier {
  LIGHT
  BUSY
}

/// Visits seen on a volume-priced booking: counts only, never patient details (INV-4).
model VisitCount {
  assignmentId         String     @id
  assignment           Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  providerVisits       Int?
  providerAt           DateTime?  @db.Timestamptz(3)
  clinicVisits         Int?
  clinicAt             DateTime?  @db.Timestamptz(3)
  clinicUserId         String?
  clinicReason         String?
  /// OPEN (waiting for the clinic's window) | DISPUTED (admin review) | FINAL
  status               String     @default("OPEN")
  /// PROVIDER | AGREED | SPLIT | DISPUTED | ADMIN | DECLARED (no provider count)
  outcome              String?
  finalVisits          Int?
  overageVisits        Int        @default(0)
  overageClinicCents   Int        @default(0)
  overageProviderCents Int        @default(0)
  /// When the extra-visit fee may be charged (clinic's dispute window end).
  chargeDueAt          DateTime?  @db.Timestamptz(3)
  chargedAt            DateTime?  @db.Timestamptz(3)
  resolvedById         String?
  resolutionNote       String?
  reconciliation       Json?
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @db.Timestamptz(3)

  @@index([status, chargeDueAt])
}

/// Lowest pay a provider accepts per profession (filter F12). Never shown to clinics.
model ProviderPayFloor {
  providerId      String
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  professionCode  String
  minHalfDayCents Int?
  minFullDayCents Int?
  minHourlyCents  Int?
  includeMileage  Boolean  @default(false)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@id([providerId, professionCode])
}

// ============================ help center / support ============================

/// A signed-in clinic or provider asking us for help (Help center → Contact support).
model SupportRequest {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CLINIC | PROVIDER
  audience      String
  clinicOrgId   String?
  providerId    String?
  topic         String
  subject       String
  /// Optional shift this is about (id only; shown as a link for admins).
  shiftId       String?
  /// "Need help now?" escalation: alerts admins by text/push and emails the support inbox.
  urgent        Boolean          @default(false)
  /// CALLBACK | TEXT | EMAIL: how they want us to reach them (urgent requests).
  contactMethod String?
  contactPhone  String?
  contactEmail  String?
  /// When our team reached them (urgent requests).
  contactedAt   DateTime?        @db.Timestamptz(3)
  contactedById String?
  /// OPEN (waiting on us) | ANSWERED (waiting on them) | CLOSED
  status        String           @default("OPEN")
  lastMessageAt DateTime         @default(now()) @db.Timestamptz(3)
  closedAt      DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  messages      SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@index([urgent, contactedAt])
}

model SupportMessage {
  id           String         @id @default(cuid())
  requestId    String
  request      SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorUserId String?
  fromStaff    Boolean        @default(false)
  body         String
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([requestId, createdAt])
}

// ============================ recruit a colleague for a shift ============================

/// Admin "Recruit a colleague" link for one shift (/s/<token>). Anyone can open the summary; signing
/// up (or signing in) as a provider claims it, and once eligible they get an invitation to the shift.
model ShiftRecruitLink {
  id          String              @id @default(cuid())
  token       String              @unique
  shiftId     String
  shift       Shift               @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdById String?
  /// Who it was sent to (admin's note), e.g. "Dr. Lee".
  label       String?
  views       Int                 @default(0)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  claims      ShiftRecruitClaim[]

  @@index([shiftId])
}

model ShiftRecruitClaim {
  id         String           @id @default(cuid())
  linkId     String
  link       ShiftRecruitLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /// When the invitation (Offer, source ADMIN) was sent once they became eligible.
  invitedAt  DateTime?        @db.Timestamptz(3)
  offerId    String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([linkId, providerId])
  @@index([providerId])
}
