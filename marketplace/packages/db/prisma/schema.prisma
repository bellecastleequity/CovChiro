// Coverage marketplace — data model (SPEC §5 as revised by Addendum 01 §6).
// Raw SQL for PostGIS columns, triggers and the exclusion constraint lives in
// migrations/0002_invariants. Money is integer cents throughout.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // native = this machine; rhel-* = CloudLinux/AlmaLinux cPanel hosts; debian = Docker images.
  binaryTargets   = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, btree_gist, citext]
}

// ============================ identity ============================

enum Role {
  CLINIC_OWNER
  CLINIC_STAFF
  PROVIDER
  PLATFORM_ADMIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique @db.Citext
  name            String
  phone           String?
  passwordHash    String?
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  phoneVerifiedAt DateTime? @db.Timestamptz(3)
  mfaEnabled      Boolean   @default(false)
  totpSecret      String?
  role            Role
  disabledAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  lastLoginAt     DateTime? @db.Timestamptz(3)

  provider      Provider?
  clinicMembers ClinicMember[]
  sessions      Session[]
  notifications Notification[]
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 of the cookie token — the raw token is never stored.
  tokenHash   String   @unique
  mfaVerified Boolean  @default(false)
  expiresAt   DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  userAgent   String?

  @@index([userId])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  purpose   String // EMAIL_VERIFY | PASSWORD_RESET | PHONE_VERIFY
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose])
}

model RateLimit {
  key       String   @id
  count     Int
  windowEnd DateTime @db.Timestamptz(3)
}

// ============================ professions (Addendum 01 §3) ============================

enum PricingModel {
  TIERED
  HOURLY
}

model Profession {
  code                                 String       @id
  displayName                          String
  /// URL slug for the public landing page, e.g. "massage-therapy".
  slug                                 String       @unique
  credentialSuffix                     String
  npiRequired                          Boolean
  pricingModel                         PricingModel
  defaultMalpracticeMinOccurrenceCents Int
  defaultMalpracticeMinAggregateCents  Int
  requiresSupervisionDefault           Boolean      @default(false)
  defaultSupervisingProfessionCodes    String[]     @default([])
  active                               Boolean      @default(false)
  sortOrder                            Int

  stateConfigs ProfessionStateConfig[]
  providers    ProviderProfession[]
  licenses     License[]
  skills       Skill[]
  rateCards    RateCard[]
}

model ProfessionStateConfig {
  professionCode                String
  profession                    Profession @relation(fields: [professionCode], references: [code])
  state                         String     @db.Char(2)
  enabled                       Boolean    @default(false)
  legalReviewComplete           Boolean    @default(false)
  legalReviewNotes              String?
  licensedAtStateLevel          Boolean    @default(true)
  /// Owner-approved alternative credential policy where not state-licensed (§3.3). Ships disabled.
  alternativeCredentialAllowed  Boolean    @default(false)
  alternativeCredentialPolicy   String?
  credentialTitle               String?
  boardLookupUrl                String?
  /// null = not yet filled in (blocks enabling).
  supervisionRequired           Boolean?
  supervisingProfessionCodes    String[]   @default([])
  supervisionNotes              String?
  /// Resolved minimums (profession default unless overridden), cents — the trigger reads these.
  malpracticeMinOccurrenceCents Int?
  malpracticeMinAggregateCents  Int?
  scopeNotes                    String?
  enabledAt                     DateTime?  @db.Timestamptz(3)
  enabledById                   String?

  @@id([professionCode, state])
}

enum ProviderProfessionStatus {
  ONBOARDING
  ACTIVE
  PAUSED
}

model ProviderProfession {
  providerId        String
  professionCode    String
  yearsInPractice   Int?
  specialties       String[]                 @default([])
  status            ProviderProfessionStatus @default(ONBOARDING)
  /// Profession addendum signature (ATTORNEY REVIEW; gated by feature flag).
  addendumSignedAt  DateTime?                @db.Timestamptz(3)
  profileCompleteAt DateTime?                @db.Timestamptz(3)
  provider          Provider                 @relation(fields: [providerId], references: [id], onDelete: Cascade)
  profession        Profession               @relation(fields: [professionCode], references: [code])

  @@id([providerId, professionCode])
}

// ============================ providers ============================

enum ProviderStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  SUSPENDED
  DEACTIVATED
}

model Provider {
  id                   String                                 @id @default(cuid())
  userId               String                                 @unique
  user                 User                                   @relation(fields: [userId], references: [id])
  legalName            String
  displayName          String
  photoUrl             String?
  npi                  String?                                @unique
  npiVerifiedAt        DateTime?                              @db.Timestamptz(3)
  npiMismatch          Boolean                                @default(false)
  homeAddress          String?
  homeLat              Float?
  homeLng              Float?
  homeCity             String?
  /// Display only — NEVER used for eligibility (INV-1).
  homeState            String?
  homeTimeZone         String                                 @default("America/New_York")
  homeGeo              Unsupported("geography(Point, 4326)")?
  maxDriveMinutes      Int                                    @default(90)
  willingOvernight     Boolean                                @default(false)
  bio                  String?
  school               String?
  graduationYear       Int?
  languages            String[]                               @default([])
  ehrSystems           String[]                               @default([])
  xrayComfort          Boolean                                @default(false)
  /// Has treated personal-injury (auto accident / PI) patients. null = not answered yet.
  personalInjuryExperience Boolean?
  /// Admin pushed this provider through onboarding: the profile, photo, email,
  /// NPI and agreement steps no longer block activation. Credentials (INV-1/3)
  /// and payouts are still required by matching.
  adminApprovedAt          DateTime?                @db.Timestamptz(3)
  adminApprovedById        String?
  maxPatientsPerDay    Int?
  stripeAccountId      String?                                @unique
  stripePayoutsEnabled Boolean                                @default(false)
  agreementSignedAt    DateTime?                              @db.Timestamptz(3)
  agreementVersion     Int?
  profileCompleteAt    DateTime?                              @db.Timestamptz(3)
  status               ProviderStatus                         @default(ONBOARDING)
  adminNotes           String?
  createdAt            DateTime                               @default(now()) @db.Timestamptz(3)

  /// Public profile (About me = bio).
  headline                 String?
  linkedinUrl              String?
  /// Offers & On Call (Addendum 02). Quiet hours are minutes from local midnight in homeTimeZone.
  quietHoursStart          Int                      @default(1260)
  quietHoursEnd            Int                      @default(360)
  urgentDuringQuietHours   Boolean                  @default(false)
  snoozedUntil             DateTime?                @db.Timestamptz(3)
  consecutiveIgnoredOffers Int                      @default(0)
  oncallPausedReason       String?
  smsConsentAt             DateTime?                @db.Timestamptz(3)
  onCallRules              OnCallRule[]
  responsiveness           ProviderResponsiveness[]
  standby                  StandbyEntry[]
  professions              ProviderProfession[]
  licenses                 License[]
  malpractice              MalpracticePolicy[]
  skills                   ProviderSkill[]
  availability             AvailabilityRule[]
  blackouts                AvailabilityBlackout[]
  openDates                AvailabilityOpenDate[]
  applications             Application[]
  offers                   Offer[]
  assignments              Assignment[]
  stats                    ProviderStats?
  payouts                  Payout[]
  transfers                PayoutTransfer[]
  threads                  MessageThread[]
}

enum LicenseStatus {
  PENDING_VERIFICATION
  VERIFIED
  EXPIRED
  SUSPENDED
  REVOKED
  REJECTED
}

model License {
  id                      String        @id @default(cuid())
  providerId              String
  provider                Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  professionCode          String
  profession              Profession    @relation(fields: [professionCode], references: [code])
  state                   String        @db.Char(2)
  licenseNumber           String
  /// Title as issued in that state (e.g. LMT vs LMBT, L.Ac. vs A.P.).
  credentialTitle         String?
  issuedAt                DateTime?     @db.Timestamptz(3)
  expiresAt               DateTime      @db.Timestamptz(3)
  status                  LicenseStatus @default(PENDING_VERIFICATION)
  verifiedById            String?
  verifiedAt              DateTime?     @db.Timestamptz(3)
  verificationMethod      String?
  verificationEvidenceUrl String?
  documentUrl             String?
  rejectionReason         String?
  nextReverifyAt          DateTime?     @db.Timestamptz(3)
  createdAt               DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([providerId, professionCode, state])
  @@index([professionCode, state, status, expiresAt])
}

model MalpracticePolicy {
  id                     String        @id @default(cuid())
  providerId             String
  provider               Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  carrier                String
  policyNumber           String
  /// Cents (Addendum 01 §6); Int caps a single limit at ~$21.4M.
  perOccurrenceCents     Int
  aggregateCents         Int
  /// Professions this policy covers; must include the shift's profession (INV-3).
  coveredProfessionCodes String[]      @default([])
  expiresAt              DateTime      @db.Timestamptz(3)
  documentUrl            String
  status                 LicenseStatus @default(PENDING_VERIFICATION)
  verifiedById           String?
  verifiedAt             DateTime?     @db.Timestamptz(3)
  rejectionReason        String?
  createdAt              DateTime      @default(now()) @db.Timestamptz(3)

  @@index([providerId, status, expiresAt])
}

/// Profession-scoped skill (was Technique). professionCode null = cross-profession.
model Skill {
  id                    String           @id @default(cuid())
  name                  String
  professionCode        String?
  profession            Profession?      @relation(fields: [professionCode], references: [code])
  scopeSensitive        Boolean          @default(false)
  requiresCertification Boolean          @default(false)
  active                Boolean          @default(true)
  providers             ProviderSkill[]
  locations             LocationSkill[]
  stateRules            SkillStateRule[]

  @@unique([name, professionCode])
}

model ProviderSkill {
  providerId                String
  skillId                   String
  proficiency               Int            @default(2)
  certificationUrl          String?
  certificationStatus       LicenseStatus?
  certificationExpiresAt    DateTime?      @db.Timestamptz(3)
  certificationVerifiedById String?
  certificationVerifiedAt   DateTime?      @db.Timestamptz(3)
  provider                  Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  skill                     Skill          @relation(fields: [skillId], references: [id])

  @@id([providerId, skillId])
}

/// Scope-of-practice rule for a scope-sensitive skill. A missing rule means "not allowed".
model SkillStateRule {
  skillId        String
  professionCode String
  state          String  @db.Char(2)
  allowed        Boolean
  notes          String?
  skill          Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([skillId, professionCode, state])
}

model AvailabilityRule {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  weekday    Int
  startMin   Int
  endMin     Int
  timeZone   String
}

model AvailabilityBlackout {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  startsAt   DateTime @db.Timestamptz(3)
  endsAt     DateTime @db.Timestamptz(3)
  reason     String?
}

model AvailabilityOpenDate {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  startsAt   DateTime @db.Timestamptz(3)
  endsAt     DateTime @db.Timestamptz(3)
}

model ProviderStats {
  providerId            String    @id
  provider              Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  completedShifts       Int       @default(0)
  lateCancels           Int       @default(0)
  noShows               Int       @default(0)
  ratingSum             Int       @default(0)
  ratingCount           Int       @default(0)
  lastShiftAt           DateTime? @db.Timestamptz(3)
  shiftsThisMonth       Int       @default(0)
  /// { "DC": { "sum": 45, "count": 10 } }
  ratingByProfession    Json      @default("{}")
  /// { "DC": 12 } — drives the per-profession new-provider boost.
  completedByProfession Json      @default("{}")
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
}

// ============================ clinics ============================

enum ClinicStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model ClinicOrg {
  id                 String       @id @default(cuid())
  legalName          String
  displayName        String
  logoUrl            String?
  phone              String?
  billingEmail       String?
  stripeCustomerId   String?      @unique
  hasPaymentMethod   Boolean      @default(false)
  paymentMethodLabel String?
  agreementSignedAt  DateTime?    @db.Timestamptz(3)
  agreementVersion   Int?
  status             ClinicStatus @default(ONBOARDING)
  adminNotes         String?
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)

  members          ClinicMember[]
  locations        ClinicLocation[]
  threads          MessageThread[]
  promoRedemptions PromoRedemption[]
  payments         Payment[]
  /// Admin pushed this clinic through onboarding (location / agreement steps waived; a payment method is still needed to post).
  adminApprovedAt    DateTime? @db.Timestamptz(3)
  adminApprovedById  String?
}

model ClinicMember {
  id          String    @id @default(cuid())
  clinicOrgId String
  clinicOrg   ClinicOrg @relation(fields: [clinicOrgId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role

  @@unique([clinicOrgId, userId])
}

model ClinicLocation {
  id                String                                 @id @default(cuid())
  clinicOrgId       String
  clinicOrg         ClinicOrg                              @relation(fields: [clinicOrgId], references: [id], onDelete: Cascade)
  name              String
  addressLine1      String
  addressLine2      String?
  city              String
  /// FROM GEOCODE ONLY. Changing requires re-geocode (geocodedAt) — enforced by trigger.
  state             String                                 @db.Char(2)
  zip               String
  lat               Float
  lng               Float
  geo               Unsupported("geography(Point, 4326)")?
  timeZone          String
  /// Professions this location posts shifts for.
  professionCodes   String[]                               @default([])
  geocodedAt        DateTime                               @db.Timestamptz(3)
  rateRegionId      String?
  rateRegion        RateRegion?                            @relation(fields: [rateRegionId], references: [id])
  phone             String?
  onSiteContactName String?
  patientsPerDay    Int?
  ehr               String?
  equipment         String[]                               @default([])
  dressCode         String?
  /// Visible to the confirmed provider only.
  arrivalNotes      String?
  active            Boolean                                @default(true)
  createdAt         DateTime                               @default(now()) @db.Timestamptz(3)
  skills            LocationSkill[]
  shifts            Shift[]
  shiftGroups       ShiftGroup[]
}

model LocationSkill {
  locationId String
  skillId    String
  location   ClinicLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  skill      Skill          @relation(fields: [skillId], references: [id])

  @@id([locationId, skillId])
}

// ============================ shifts & matching ============================

model ShiftGroup {
  id                   String         @id @default(cuid())
  locationId           String
  location             ClinicLocation @relation(fields: [locationId], references: [id])
  sameProviderRequired Boolean        @default(false)
  shifts               Shift[]
}

enum ShiftStatus {
  DRAFT
  OPEN
  FAVORITES_ONLY
  SELECTING
  CASCADING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  UNFILLED
  CANCELLED
}

model Shift {
  id                      String         @id @default(cuid())
  locationId              String
  location                ClinicLocation @relation(fields: [locationId], references: [id])
  shiftGroupId            String?
  shiftGroup              ShiftGroup?    @relation(fields: [shiftGroupId], references: [id])
  /// Copy of location.state, set and kept in sync by trigger.
  state                   String         @db.Char(2)
  professionCode          String
  /// INV-8 attestation: { supervisorName, supervisorProfessionCode, supervisorLicenseNumber, onSiteEntireShift }.
  supervisionAttestation  Json?
  supervisionAttestedById String?
  supervisionAttestedAt   DateTime?      @db.Timestamptz(3)
  startsAt                DateTime       @db.Timestamptz(3)
  endsAt                  DateTime       @db.Timestamptz(3)
  status                  ShiftStatus    @default(DRAFT)
  requiredSkillIds        String[]       @default([])
  preferredSkillIds       String[]       @default([])
  expectedPatients        Int?
  notes                   String?
  instantBook             Boolean        @default(false)
  maxTravelBudgetCents    Int?
  lodgingAllowed          Boolean        @default(false)
  lodgingCapCentsPerNight Int?
  // Pricing snapshot from the rate engine (INV-7)
  rateCardId              String?
  durationTier            DurationTier?
  clinicPriceCents        Int
  providerPayCents        Int
  premiumsApplied         Json           @default("[]")
  boosted                 Boolean        @default(false)
  /// Emergency cover (no-show / late cancel): broadcast to everyone at once, wider radius, rescue bonus from margin.
  emergencyAt             DateTime?      @db.Timestamptz(3)
  emergencySource         String?
  emergencyReason         String?
  emergencyBonusPercent   Int            @default(0)
  emergencyBasePayCents   Int?
  /// Replacement for the remaining time of a shift whose provider didn't show.
  rescueOfShiftId         String?
  promoCodeId             String?
  promoCode               PromoCode?     @relation(fields: [promoCodeId], references: [id])
  promoDiscountCents      Int            @default(0)
  // Matching timeline
  postedAt                DateTime?      @db.Timestamptz(3)
  favoritesWindowEndsAt   DateTime?      @db.Timestamptz(3)
  selectionDeadline       DateTime?      @db.Timestamptz(3)
  cascadeStartedAt        DateTime?      @db.Timestamptz(3)
  cancelledAt             DateTime?      @db.Timestamptz(3)
  cancelReason            String?
  createdById             String
  createdAt               DateTime       @default(now()) @db.Timestamptz(3)

  applications Application[]
  offers       Offer[]
  /// At most one active assignment (partial unique index); cancelled ones stay for history.
  assignments  Assignment[]
  dispatches   Dispatch[]
  standby      StandbyEntry[]
  matchRuns    MatchRun[]
  threads      MessageThread[]

  @@index([professionCode, state, status, startsAt])
  @@index([locationId, startsAt])
}

enum ApplicationStatus {
  ACTIVE
  WITHDRAWN
  SELECTED
  NOT_SELECTED
  AUTO_WITHDRAWN_CONFLICT
  INELIGIBLE
}

model Application {
  id                 String            @id @default(cuid())
  shiftId            String
  shift              Shift             @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  providerId         String
  provider           Provider          @relation(fields: [providerId], references: [id])
  note               String?
  status             ApplicationStatus @default(ACTIVE)
  scoreAtApply       Float
  scoreBreakdown     Json?
  clinicMarkedNotFit Boolean           @default(false)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  withdrawnAt        DateTime?         @db.Timestamptz(3)

  @@unique([shiftId, providerId])
  @@index([providerId, status])
}

enum OfferSource {
  CLINIC_PICK
  DISPATCH
  BROADCAST
  STANDBY
  ADMIN
}

enum OfferStatus {
  PENDING
  ACCEPTED_PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  NOT_SELECTED
  WITHDRAWN
  INELIGIBLE
}

model Offer {
  id             String       @id @default(cuid())
  shiftId        String
  shift          Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  providerId     String
  provider       Provider     @relation(fields: [providerId], references: [id])
  source         OfferSource
  expiresAt      DateTime     @db.Timestamptz(3)
  status         OfferStatus  @default(PENDING)
  respondedAt    DateTime?    @db.Timestamptz(3)
  rank           Int?
  // Smart Dispatch (Addendum 02 §10)
  dispatchId     String?
  dispatch       Dispatch?    @relation(fields: [dispatchId], references: [id])
  waveId         String?
  wave           Wave?        @relation(fields: [waveId], references: [id])
  tier           UrgencyTier?
  windowMinutes  Int?
  matchScore     Float        @default(0)
  dispatchScore  Float        @default(0)
  pRespondAtSend Float        @default(0.5)
  replyCode      String?
  linkTokenHash  String?      @unique
  channelsSent   String[]     @default([])
  deliveredAt    DateTime?    @db.Timestamptz(3)
  openedAt       DateTime?    @db.Timestamptz(3)
  acceptedAt     DateTime?    @db.Timestamptz(3)
  revived        Boolean      @default(false)
  /// Set when an application stands in for an acceptance (§5.6).
  applicationId  String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([providerId, status])
  @@index([shiftId, status])
}

model MatchRun {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  reason    String
  /// Every candidate considered: score breakdown or the filters that excluded them.
  results   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([shiftId, createdAt])
}

enum AssignmentStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  LICENSE_LAPSED
  DISPUTED
  NO_SHOW
}

enum SelectionMethod {
  CLINIC_PICKED_APPLICANT
  CLINIC_PICKED_OFFER
  AUTO_APPLICANT
  INSTANT_BOOK
  ADMIN
  ON_CALL_AUTO
  DISPATCH_WAVE
  DISPATCH_BROADCAST
  STANDBY
}

enum CancelParty {
  CLINIC
  PROVIDER
  PLATFORM
}

model Assignment {
  id                   String                    @id @default(cuid())
  /// Not unique: a cancelled/lapsed assignment stays for history when the shift is backfilled.
  shiftId              String
  shift                Shift                     @relation(fields: [shiftId], references: [id])
  providerId           String
  provider             Provider                  @relation(fields: [providerId], references: [id])
  /// Copy of shift.state; checked by trigger (INV-1).
  state                String                    @db.Char(2)
  /// Copy of shift.professionCode; checked by trigger (INV-1).
  professionCode       String
  startsAt             DateTime                  @db.Timestamptz(3)
  endsAt               DateTime                  @db.Timestamptz(3)
  bufferMinutes        Int
  /// [startsAt − buffer, endsAt + buffer), maintained by trigger; INV-2 exclusion constraint.
  bufferedRange        Unsupported("tstzrange")?
  status               AssignmentStatus          @default(CONFIRMED)
  selectionMethod      SelectionMethod
  driveMinutes         Int
  driveMiles           Float
  clinicPriceCents     Int
  providerPayCents     Int
  promoDiscountCents   Int                       @default(0)
  mileageCents         Int
  lodgingEstimateCents Int                       @default(0)
  lodgingApprovedCents Int                       @default(0)
  clinicTotalCents     Int
  providerTotalCents   Int
  depositCents         Int                       @default(0)
  flags                String[]                  @default([])
  /// On Call auto-accepts: no-penalty cancel allowed until this time (Addendum 02 §4.5).
  graceEndsAt          DateTime?                 @db.Timestamptz(3)
  confirmedAt          DateTime                  @default(now()) @db.Timestamptz(3)
  /// Attendance (reconfirmation + day-of check-in): each step is claimed once.
  reconfirmRequestedAt DateTime?                 @db.Timestamptz(3)
  reconfirmRemindedAt  DateTime?                 @db.Timestamptz(3)
  reconfirmedAt        DateTime?                 @db.Timestamptz(3)
  checkinPromptedAt    DateTime?                 @db.Timestamptz(3)
  onMyWayAt            DateTime?                 @db.Timestamptz(3)
  /// The clinic confirmed the provider arrived.
  arrivedAt            DateTime?                 @db.Timestamptz(3)
  checkinAlertedAt     DateTime?                 @db.Timestamptz(3)
  startedAt            DateTime?                 @db.Timestamptz(3)
  completedAt          DateTime?                 @db.Timestamptz(3)
  cancelledAt          DateTime?                 @db.Timestamptz(3)
  cancelledBy          CancelParty?
  cancelReason         String?

  payments        Payment[]
  payouts         Payout[]
  ratings         Rating[]
  lodgingReceipts LodgingReceipt[]
  disputes        Dispute[]

  @@index([providerId, status, startsAt])
  @@index([shiftId])
}

// ============================ relationships & reputation ============================

enum PartyType {
  CLINIC
  PROVIDER
}

model Favorite {
  id        String    @id @default(cuid())
  fromType  PartyType
  fromId    String
  toType    PartyType
  toId      String
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([fromType, fromId, toType, toId])
}

model Block {
  id        String    @id @default(cuid())
  fromType  PartyType
  fromId    String
  toType    PartyType
  toId      String
  reason    String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([fromType, fromId, toType, toId])
}

model Rating {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  raterType    PartyType
  stars        Int
  categories   Json
  comment      String?
  submittedAt  DateTime   @default(now()) @db.Timestamptz(3)
  revealedAt   DateTime?  @db.Timestamptz(3)

  @@unique([assignmentId, raterType])
}

// ============================ messaging ============================

model MessageThread {
  id            String    @id @default(cuid())
  clinicOrgId   String
  clinicOrg     ClinicOrg @relation(fields: [clinicOrgId], references: [id])
  providerId    String
  provider      Provider  @relation(fields: [providerId], references: [id])
  shiftId       String?
  shift         Shift?    @relation(fields: [shiftId], references: [id])
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastMessageAt DateTime  @default(now()) @db.Timestamptz(3)
  messages      Message[]

  @@unique([clinicOrgId, providerId])
}

model Message {
  id               String        @id @default(cuid())
  threadId         String
  thread           MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUserId     String
  senderType       PartyType
  body             String
  redacted         Boolean       @default(false)
  flagged          Boolean       @default(false)
  containedContact Boolean       @default(false)
  readAt           DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)

  @@index([threadId, createdAt])
}

// ============================ money ============================

enum PaymentType {
  DEPOSIT
  BALANCE
  LODGING
  CANCELLATION_FEE
  CONVERSION_FEE
  REFUND
  ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

model Payment {
  id                    String        @id @default(cuid())
  clinicOrgId           String
  clinicOrg             ClinicOrg     @relation(fields: [clinicOrgId], references: [id])
  assignmentId          String?
  assignment            Assignment?   @relation(fields: [assignmentId], references: [id])
  type                  PaymentType
  amountCents           Int
  stripePaymentIntentId String?       @unique
  stripeRefundId        String?       @unique
  idempotencyKey        String        @unique
  status                PaymentStatus @default(PENDING)
  failureReason         String?
  description           String?
  createdById           String?
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)

  @@index([assignmentId])
  @@index([clinicOrgId, createdAt])
}

enum PayoutKind {
  SHIFT
  LODGING
  LATE_CANCEL
  ADJUSTMENT
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  ON_HOLD
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

/// Provider pay ledger — one row per amount owed (see packages/core/src/payouts.ts).
model Payout {
  id           String          @id @default(cuid())
  providerId   String
  provider     Provider        @relation(fields: [providerId], references: [id])
  assignmentId String?
  assignment   Assignment?     @relation(fields: [assignmentId], references: [id])
  kind         PayoutKind
  description  String
  /// Provider pay + mileage (SHIFT), receipt (LODGING), share (LATE_CANCEL), ± (ADJUSTMENT).
  amountCents  Int
  status       PayoutStatus    @default(PENDING)
  onHold       Boolean         @default(false)
  holdReason   String?
  releaseAt    DateTime?       @db.Timestamptz(3)
  transferId   String?
  transfer     PayoutTransfer? @relation(fields: [transferId], references: [id])
  paidAt       DateTime?       @db.Timestamptz(3)
  createdById  String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([assignmentId, kind])
  @@index([providerId, status])
  @@index([status, releaseAt])
}

enum TransferStatus {
  PROCESSING
  PAID
  FAILED
  REVERSED
}

/// One Stripe Connect transfer, covering one or more ledger rows for a provider.
model PayoutTransfer {
  id               String         @id @default(cuid())
  providerId       String
  provider         Provider       @relation(fields: [providerId], references: [id])
  amountCents      Int
  stripeTransferId String?        @unique
  idempotencyKey   String         @unique
  status           TransferStatus @default(PROCESSING)
  failureReason    String?
  /// null = released automatically by the payoutRelease job.
  initiatedById    String?
  note             String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  paidAt           DateTime?      @db.Timestamptz(3)
  payouts          Payout[]

  @@index([providerId, createdAt])
}

model LodgingReceipt {
  id            String     @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  nights        Int        @default(1)
  amountCents   Int
  fileUrl       String
  status        String     @default("SUBMITTED") // SUBMITTED | APPROVED | REJECTED
  approvedCents Int?
  reviewedById  String?
  reviewedAt    DateTime?  @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
}

model Dispute {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  openedByType PartyType
  openedById   String
  reason       String
  status       String     @default("OPEN") // OPEN | RESOLVED
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([assignmentId, status])
}

// ============================ agreements ============================

model AgreementSignature {
  id           String    @id @default(cuid())
  partyType    PartyType
  partyId      String
  signerUserId String
  version      Int
  provider     String // "dropbox-sign" | "dev"
  envelopeId   String?   @unique
  status       String    @default("SENT") // SENT | SIGNED | DECLINED
  signedAt     DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([partyType, partyId])
}

// ============================ states & rates ============================

model StateConfig {
  state                        String    @id @db.Char(2)
  enabled                      Boolean   @default(false)
  legalReviewComplete          Boolean   @default(false)
  legalReviewNotes             String?
  contractorModelNotes         String?
  staffingRegistrationRequired Boolean   @default(false)
  salesTaxOnStaffing           Boolean   @default(false)
  boardLookupUrl               String?
  defaultRateRegionId          String?
  enabledAt                    DateTime? @db.Timestamptz(3)
  enabledById                  String?
}

model RateRegion {
  id        String           @id @default(cuid())
  state     String           @db.Char(2)
  name      String           @unique
  zip3List  String[]         @default([])
  tier      Int
  rateCards RateCard[]
  locations ClinicLocation[]
}

enum DurationTier {
  HALF_DAY
  FULL_DAY
  HOURLY
}

model RateCard {
  id               String       @id @default(cuid())
  rateRegionId     String
  rateRegion       RateRegion   @relation(fields: [rateRegionId], references: [id])
  professionCode   String
  profession       Profession   @relation(fields: [professionCode], references: [code])
  durationTier     DurationTier
  /// TIERED: flat price for the tier. HOURLY: per-hour rate.
  clinicPriceCents Int
  providerPayCents Int
  /// HOURLY only: minimum billable hours (falls back to pricing.hourlyMinHours).
  minHours         Float?
  effectiveFrom    DateTime     @db.Timestamptz(3)
  effectiveTo      DateTime?    @db.Timestamptz(3)

  @@index([professionCode, rateRegionId, durationTier, effectiveFrom])
}

// ============================ promo codes ============================

enum PromoKind {
  PERCENT
  FIXED
}

model PromoCode {
  id                 String      @id @default(cuid())
  code               String      @unique
  kind               PromoKind
  /// Percent (0–100) for PERCENT, cents for FIXED.
  value              Int
  description        String?
  active             Boolean     @default(true)
  startsAt           DateTime?   @db.Timestamptz(3)
  expiresAt          DateTime?   @db.Timestamptz(3)
  maxUses            Int?
  usedCount          Int         @default(0)
  maxUsesPerClinic   Int?        @default(1)
  firstShiftOnly     Boolean     @default(false)
  assignedEmail      String?     @db.Citext
  isWelcome          Boolean     @default(false)
  /// Personal copies of a campaign code point at their library code.
  parentId           String?
  parent             PromoCode?  @relation("PromoCopies", fields: [parentId], references: [id])
  copies             PromoCode[] @relation("PromoCopies")
  // Campaign landing page (/offer/CODE)
  landingEnabled     Boolean     @default(false)
  landingAudience    PartyType   @default(CLINIC)
  landingHeadline    String?
  landingDescription String?
  landingVisits      Int         @default(0)
  /// [{subject, intro}] per follow-up email; blanks fall back to the standard copy.
  dripCustom         Json?
  createdById        String?
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)

  shifts      Shift[]
  redemptions PromoRedemption[]

  @@index([parentId])
}

model PromoRedemption {
  id            String    @id @default(cuid())
  promoCodeId   String
  promoCode     PromoCode @relation(fields: [promoCodeId], references: [id])
  clinicOrgId   String
  clinicOrg     ClinicOrg @relation(fields: [clinicOrgId], references: [id])
  shiftId       String    @unique
  discountCents Int
  /// Cleared if the shift is cancelled/refunded before completion.
  voidedAt      DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([promoCodeId])
  @@index([clinicOrgId])
}

// ============================ leads & analytics ============================

enum LeadStatus {
  NEW
  NURTURING
  CONTACTED
  CONVERTED
  UNSUBSCRIBED
  EXPIRED
  SUPERSEDED
  LOST
}

model Lead {
  id               String         @id @default(cuid())
  audience         PartyType      @default(CLINIC)
  /// Provider leads / waitlist signups: which profession they're interested in.
  professionCode   String?
  name             String
  email            String         @db.Citext
  phone            String?
  organization     String?
  state            String?        @db.Char(2)
  message          String?
  /// popup | landing | contact | waitlist | manual
  source           String
  campaignCode     String         @default("")
  promoCode        String?
  status           LeadStatus     @default(NEW)
  dripStep         Int            @default(0)
  lastDripSentAt   DateTime?      @db.Timestamptz(3)
  nextDripAt       DateTime?      @db.Timestamptz(3)
  unsubscribeToken String         @unique
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  landingPath      String?
  convertedAt      DateTime?      @db.Timestamptz(3)
  convertedUserId  String?
  /// First confirmed shift after converting (clinic leads), for campaign revenue.
  convertedShiftId String?
  ownerId          String?
  followUpAt       DateTime?      @db.Timestamptz(3)
  unsubscribedAt   DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  activities       LeadActivity[]

  @@unique([email, campaignCode])
  @@index([status, nextDripAt])
  @@index([createdAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// NOTE | EMAIL_SENT | STATUS | CALL | SIGNUP | CONVERTED
  kind      String
  body      String
  actorId   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([leadId, createdAt])
}

/// First-party, cookieless-ish analytics: an anonymous visitor id in a
/// first-party cookie, no IP address stored.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  /// PAGE_VIEW | CTA_CLICK | LEAD_CAPTURED | SIGNUP | SHIFT_POSTED | ...
  type        String
  path        String?
  referrer    String?
  visitorId   String?
  userId      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  props       Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([type, createdAt])
  @@index([createdAt])
}

// ============================ platform ============================

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String
  template  String
  title     String
  body      String?
  link      String?
  payload   Json      @default("{}")
  sentAt    DateTime? @db.Timestamptz(3)
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt])
}

model AdminTask {
  id           String    @id @default(cuid())
  /// UNMAPPED_ZIP3 | LOW_RATING | LICENSE_LAPSED | REVERIFY | DISPUTE | FLAGGED_MESSAGES | LATE_CANCELS
  kind         String
  title        String
  entityType   String?
  entityId     String?
  resolvedAt   DateTime? @db.Timestamptz(3)
  resolvedById String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([resolvedAt, createdAt])
}

// ============================ Smart Dispatch & On Call (Addendum 02) ============================

enum UrgencyTier {
  SAME_DAY
  SHORT
  NEAR
  PLANNED
}

enum DispatchTrigger {
  URGENT_POST
  SELECTION_DEADLINE
  BACKFILL
  CLINIC_REQUEST
  ADMIN
  RATE_BOOST
}

enum DispatchStatus {
  ACTIVE
  FILLED
  EXHAUSTED
  CANCELLED
}

enum DispatchStage {
  STANDBY
  ON_CALL_CHECK
  WAVES
  BROADCAST
  DONE
}

model Dispatch {
  id               String           @id @default(cuid())
  shiftId          String
  shift            Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  trigger          DispatchTrigger
  status           DispatchStatus   @default(ACTIVE)
  tierAtStart      UrgencyTier
  currentWave      Int              @default(0)
  stage            DispatchStage    @default(ON_CALL_CHECK)
  /// Standby window (backfill) end, when stage = STANDBY.
  stageEndsAt      DateTime?        @db.Timestamptz(3)
  bestMatchAtStart Float?
  startedAt        DateTime         @default(now()) @db.Timestamptz(3)
  endedAt          DateTime?        @db.Timestamptz(3)
  filledOfferId    String?
  filledVia        SelectionMethod?
  filledProviderId String?
  waves            Wave[]
  offers           Offer[]

  @@index([shiftId, status])
  @@index([status, stage])
}

model Wave {
  id           String      @id @default(cuid())
  dispatchId   String
  dispatch     Dispatch    @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  number       Int
  isBroadcast  Boolean     @default(false)
  isStandby    Boolean     @default(false)
  tier         UrgencyTier
  sentAt       DateTime    @db.Timestamptz(3)
  windowEndsAt DateTime    @db.Timestamptz(3)
  holdEndsAt   DateTime?   @db.Timestamptz(3)
  closedAt     DateTime?   @db.Timestamptz(3)
  offers       Offer[]

  @@unique([dispatchId, number])
  @@index([closedAt, windowEndsAt])
}

model OnCallRule {
  id                 String    @id @default(cuid())
  providerId         String
  provider           Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  active             Boolean   @default(true)
  professionCodes    String[]
  /// [{ weekday, startMin, endMin }]
  recurringWindows   Json      @default("[]")
  /// [{ startsAt, endsAt }]
  dateWindows        Json      @default("[]")
  timeZone           String
  maxDriveMinutes    Int
  minPayHalfDayCents Int?
  minPayFullDayCents Int?
  minPayHourlyCents  Int?
  minNoticeMinutes   Int       @default(90)
  maxPerDay          Int       @default(1)
  maxPerWeek         Int       @default(5)
  favoritesOnly      Boolean   @default(false)
  minClinicRating    Float?
  excludedClinicIds  String[]  @default([])
  allowOvernight     Boolean   @default(false)
  pausedUntil        DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  @@index([providerId, active])
}

model ProviderResponsiveness {
  providerId            String
  provider              Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tier                  UrgencyTier
  offers                Float
  hits                  Float
  pRespond              Float
  medianResponseSeconds Int?
  updatedAt             DateTime    @updatedAt @db.Timestamptz(3)

  @@id([providerId, tier])
}

model StandbyEntry {
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  matchScore Float
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([shiftId, providerId])
}

/// One row per booking-digest email sent ("daily:<providerId>:<local date>",
/// "weekly:<providerId>:<week start>"), claimed before sending so repeated
/// cron ticks never send a digest twice.
model DigestSend {
  key    String   @id
  userId String
  sentAt DateTime @default(now()) @db.Timestamptz(3)
}
