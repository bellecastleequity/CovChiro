# Copy to apps/web/.env.local for local dev (the worker and scripts read the same vars).
# Any external-service key left blank falls back to a local fake (see packages/integrations).
# In production (NODE_ENV=production) web and worker refuse to boot without:
#   SESSION_SECRET, REDIS_URL, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SENDGRID_API_KEY, GOOGLE_MAPS_API_KEY

DATABASE_URL=postgresql://cm:cm@localhost:5432/coverage_app
REDIS_URL=                      # redis://localhost:6379 — unset in dev = worker uses in-process timers
SESSION_SECRET=                 # 32+ random bytes, e.g. `openssl rand -hex 32`
APP_BASE_URL=http://localhost:3000

# Brand (Addendum 01 §12) — never hard-coded in UI, email or SMS.
BRAND_NAME=CoverageOnCall
BRAND_DOMAIN=coverageoncall.com
BRAND_TAGLINE=Licensed coverage for your clinic, on call.
BRAND_SUPPORT_EMAIL=support@coverageoncall.com
EMAIL_FROM=                     # default "<BRAND_NAME> <mail@BRAND_DOMAIN>"

# Payments (Stripe + Stripe Connect Express for provider payouts)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Maps (geocoding + traffic-aware drive times)
GOOGLE_MAPS_API_KEY=

# Email / SMS
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# E-signature (Dropbox Sign)
ESIGN_API_KEY=
ESIGN_CLINIC_TEMPLATE_ID=
ESIGN_DOCTOR_TEMPLATE_ID=       # provider agreement template

# File storage — blank GCS_BUCKET = local disk under UPLOAD_DIR
GCS_BUCKET=
GCS_BUCKET_CREDENTIALS=
UPLOAD_DIR=.uploads

SENTRY_DSN=
NPPES_API_BASE=https://npiregistry.cms.hhs.gov/api/

# Seed script only
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_DEMO=                      # 1 = add demo clinic/provider accounts (never in production)
