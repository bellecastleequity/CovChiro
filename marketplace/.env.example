# Copy to apps/web/.env.local for local dev (the worker and scripts read the same file).
# Any external-service key left blank uses a built-in stand-in (see packages/integrations).
# In production (NODE_ENV=production) the site and worker refuse to start without:
#   SESSION_SECRET, REDIS_URL, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SENDGRID_API_KEY, GOOGLE_MAPS_API_KEY
# Keep comments on their own lines; quote values that contain spaces.

DATABASE_URL=postgresql://cm:cm@localhost:5432/coverage_app
# websocket = connect to Neon over port 443 (for hosts that block outgoing 5432, e.g. shared cPanel).
DATABASE_TRANSPORT=
# redis://localhost:6379 locally. Blank = worker uses in-process timers.
REDIS_URL=redis://localhost:6379
# 32+ random bytes: openssl rand -hex 32
SESSION_SECRET=
APP_BASE_URL=http://localhost:3000

# Brand (never hard-coded in UI, email or SMS)
BRAND_NAME=CoverageOnCall
BRAND_DOMAIN=coverageoncall.com
BRAND_TAGLINE="Licensed coverage for your clinic, on call."
BRAND_SUPPORT_EMAIL=support@coverageoncall.com
# Blank = "BRAND_NAME <mail@BRAND_DOMAIN>"
EMAIL_FROM=

# Stripe + Stripe Connect Express (provider payouts)
STRIPE_SECRET_KEY=
# Both webhook signing secrets ("Your account" + "Connected accounts" destinations), comma-separated.
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Google Maps Platform (Geocoding + Routes APIs)
GOOGLE_MAPS_API_KEY=

# Email / SMS
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Dropbox Sign (DOCTOR = provider agreement template)
# true = allow the built-in click-to-sign TEST agreement in production until Dropbox Sign is connected.
ESIGN_TEST_MODE=
ESIGN_API_KEY=
ESIGN_CLINIC_TEMPLATE_ID=
ESIGN_DOCTOR_TEMPLATE_ID=

# File storage. Blank GCS_BUCKET = local disk under UPLOAD_DIR.
GCS_BUCKET=
GCS_BUCKET_CREDENTIALS=
UPLOAD_DIR=.uploads

SENTRY_DSN=
NPPES_API_BASE=https://npiregistry.cms.hhs.gov/api/
