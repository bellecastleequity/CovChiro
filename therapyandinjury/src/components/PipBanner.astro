---
/**
 * Site-wide top banner (owner request): the 14-day window, "with or without a referral",
 * and a call button. Uses the location's phone on location pages, else the main number;
 * until a number is set, "Call us" goes to the Contact page.
 */
import { site, type Branch, telHref } from '../lib/site';
interface Props { branch?: Branch }
const { branch } = Astro.props;
const phone = branch?.phone ?? site.mainPhone;
const tel = telHref(phone);
---
<aside class="pip" aria-label="Car accident reminder">
  <div class="wrap pip__in">
    <p class="pip__msg">
      <span class="pip__days" aria-hidden="true">14<small>days</small></span>
      <span class="pip__long">
        <strong>Hurt in a car accident? Get checked within 14 days.</strong>
        <span class="pip__sub">We’ll see you with or without a referral.</span>
      </span>
      <span class="pip__short">
        <strong>Car accident? Get checked within 14 days.</strong>
        <span class="pip__sub">No referral needed.</span>
      </span>
    </p>
    <a class="pip__call" href={tel || '/contact/'}>
      <span aria-hidden="true">📞</span> {tel ? <Fragment>Call {phone}</Fragment> : 'Call us'}
    </a>
  </div>
</aside>
<style>
  .pip {
    background: var(--teal);
    color: var(--navy);
  }
  .pip__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 8px;
  }
  .pip__msg {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    line-height: 1.3;
    font-size: 0.95rem;
  }
  .pip__days {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--white);
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1;
  }
  .pip__days small {
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: -10px;
  }
  .pip__sub {
    display: block;
    font-weight: 600;
  }
  .pip__call {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .pip__call:hover {
    background: var(--navy-900);
  }
  .pip__call:focus-visible {
    outline-color: var(--white);
  }
  .pip__short {
    display: none;
  }
  @media (max-width: 640px) {
    .pip__long {
      display: none;
    }
    .pip__short {
      display: block;
    }
    .pip__msg {
      font-size: 0.85rem;
    }
    .pip__days {
      display: none;
    }
    .pip__call {
      padding: 8px 12px;
      font-size: 0.9rem;
    }
  }
</style>
