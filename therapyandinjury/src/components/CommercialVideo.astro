---
/**
 * Hero commercial, shown on the home page and every location page. Set in the content editor
 * (/_admin → Videos): a YouTube link, or the self-hosted MP4 in public/media/ (default: the 60-second
 * "Don't Walk It Off" spot). A location can override the site-wide video with its own.
 *
 * Self-hosted: preload="none", so only the poster loads until the visitor presses play.
 * YouTube: a poster + play button; the youtube-nocookie player loads only after a click (fast pages,
 * no YouTube cookies for visitors who don't watch). Captions are burned into our spots; the transcript
 * is for screen readers, search engines, and anyone who can't play sound.
 */
import { type Branch, type Video, heroVideoFor, youtubeId, isPlaceholder } from '../lib/site';
import { ui, type Lang } from '../lib/i18n';
interface Props { branch?: Branch; lang?: Lang; video?: Video }
const { lang = 'en' } = Astro.props;
const t = ui(lang);
// The Spanish / Creole pages pass their own commercial; everything else uses the editor's hero video.
const v = Astro.props.video ?? heroVideoFor(Astro.props.branch);
const yt = youtubeId(v.youtube);
const file = isPlaceholder(v.file) ? '' : v.file;
const poster = !isPlaceholder(v.poster) ? v.poster : yt ? `https://i.ytimg.com/vi/${yt}/hqdefault.jpg` : '';
const title = isPlaceholder(v.title) ? 'Therapy & Injury commercial' : v.title;
const paragraphs = isPlaceholder(v.transcript) ? [] : v.transcript.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const show = !!(yt || file);
---
{show && (
  <figure class="cv">
    <div class="cv__frame">
      {yt ? (
        <button type="button" class="cv__yt" data-yt={yt} aria-label={`Play video: ${title}`}>
          {poster && <img src={poster} alt="" width="1280" height="720" loading="lazy" decoding="async" />}
          <span class="cv__play" aria-hidden="true">
            <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#0b2d5b"/><path d="M45 24 27 14v20z" fill="#19ccbe"/></svg>
          </span>
        </button>
      ) : (
        <video controls playsinline preload="none" poster={poster || undefined} width="1280" height="720" aria-label={`${title} (video)`}>
          <source src={file} type="video/mp4" />
          <a href={file}>Watch the video</a>
        </video>
      )}
    </div>
    <figcaption class="cv__cap">
      <span><strong>{title}</strong>{!isPlaceholder(v.caption) && <> · {v.caption}</>}</span>
      {paragraphs.length > 0 && (
        <details class="cv__tx">
          <summary>{t.transcript}</summary>
          {paragraphs.map((p) => <p>{p}</p>)}
          <p class="cv__fine">{t.videoFine}</p>
        </details>
      )}
    </figcaption>
  </figure>
)}

<script>
  // YouTube: swap the poster for the player only when clicked.
  document.querySelectorAll<HTMLButtonElement>('.cv__yt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      f.title = btn.getAttribute('aria-label')?.replace(/^Play video: /, '') || 'Video';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      f.allowFullscreen = true;
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      btn.replaceWith(f);
    }, { once: true });
  });
</script>

<style>
  .cv {
    margin: 0;
    width: 100%;
  }
  .cv__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius, 14px);
    overflow: hidden;
    background: var(--navy);
    box-shadow: 0 18px 50px rgb(11 45 91 / 22%);
  }
  .cv video,
  .cv iframe,
  .cv__yt,
  .cv__yt img {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    background: var(--navy);
  }
  .cv__yt {
    position: relative;
    padding: 0;
    cursor: pointer;
  }
  .cv__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: transform 0.15s ease;
  }
  .cv__yt:hover .cv__play,
  .cv__yt:focus-visible .cv__play {
    transform: scale(1.08);
  }
  .cv__yt:focus-visible {
    outline: 3px solid var(--teal);
    outline-offset: -3px;
  }
  .cv__cap {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    font-size: 0.9rem;
    color: var(--slate-text, #57667a);
  }
  .cv__cap strong {
    color: var(--navy);
  }
  .cv__tx {
    flex-basis: 100%;
  }
  .cv__tx summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--navy);
    width: fit-content;
  }
  .cv__tx p {
    margin: 8px 0 0;
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .cv__fine {
    font-size: 0.8rem !important;
  }
</style>
