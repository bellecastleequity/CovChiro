---
interface Props { title?: string; text?: string; href?: string; label?: string }
const {
  title = 'Ready to get checked?',
  text = 'Find your nearest location and send a quick appointment request.',
  href = '/locations/',
  label = 'Choose a location',
} = Astro.props;
---
<section class="section section--tight cta">
  <div class="wrap cta__in">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a class="btn btn--primary" href={href}>{label}</a>
  </div>
</section>
<style>
  .cta { background: var(--navy); color: var(--white); }
  .cta h2 { color: var(--white); margin-bottom: 0.2em; }
  .cta p { margin: 0; color: #c9d3de; }
  .cta__in { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between; }
</style>
