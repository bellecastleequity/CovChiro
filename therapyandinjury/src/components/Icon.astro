---
/** Simple line icons in brand navy/teal. Decorative: always aria-hidden. */
interface Props { name: string; size?: number }
const { name, size = 44 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true" class="icon">
  <circle cx="24" cy="24" r="23" fill="#E3F8F6" />
  {name === 'eval' && (<g stroke="#0B2D5B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="15" y="12" width="18" height="24" rx="3"/><path d="M20 12v-1.5a1.5 1.5 0 0 1 1.5-1.5h5a1.5 1.5 0 0 1 1.5 1.5V12"/><path d="M19.5 21h9M19.5 26h9M19.5 31h5"/></g>)}
  {name === 'adjust' && (<g stroke="#0B2D5B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M24 10v28"/><rect x="19" y="13" width="10" height="5" rx="2"/><rect x="19" y="21.5" width="10" height="5" rx="2"/><rect x="19" y="30" width="10" height="5" rx="2"/></g>)}
  {name === 'rehab' && (<g stroke="#0B2D5B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 24h24"/><path d="M15 19v10M33 19v10M11 21v6M37 21v6"/></g>)}
  {name === 'soft' && (<g stroke="#0B2D5B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 30c3-4 6-4 9 0s6 4 9 0"/><path d="M14 22c3-4 6-4 9 0s6 4 9 0"/><path d="M33 16c1.5 0 2.5 1 2.5 2.5"/></g>)}
  {name === 'phone' && (<path d="M18 13h-3a2 2 0 0 0-2 2c0 11 9 20 20 20a2 2 0 0 0 2-2v-3l-5-2-2.5 2.5a14 14 0 0 1-8-8L22 18l-2-5z" stroke="#0B2D5B" stroke-width="2.4" stroke-linejoin="round"/>)}
  {name === 'pin' && (<g stroke="#0B2D5B" stroke-width="2.4" stroke-linejoin="round"><path d="M24 37s10-9.2 10-16.5a10 10 0 0 0-20 0C14 27.8 24 37 24 37z"/><circle cx="24" cy="20.5" r="3.5"/></g>)}
  {name === 'clock' && (<g stroke="#0B2D5B" stroke-width="2.4" stroke-linecap="round"><circle cx="24" cy="24" r="11"/><path d="M24 17v7l4.5 3"/></g>)}
  {name === 'doc' && (<g stroke="#0B2D5B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="19" r="5.5"/><path d="M14.5 36c1.5-5.5 5-8 9.5-8s8 2.5 9.5 8"/></g>)}
  {name === 'calendar' && (<g stroke="#0B2D5B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="13" y="15" width="22" height="20" rx="3"/><path d="M13 21h22M19 12v5M29 12v5"/><path d="M19.5 27.5l3 3 6-6" stroke="#0FA89C"/></g>)}
</svg>
