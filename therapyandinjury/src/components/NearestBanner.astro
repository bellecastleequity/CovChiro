---
/**
 * "Closest to you" bar on brand pages (home, FAQ, blog…; never on location pages). It only appears
 * after the visitor has used "Use my location" once: that remembers the nearest location's slug and
 * distance on this device (localStorage "ti-nearest"; no coordinates). Dismiss hides it for good.
 * Names and links come from the live data, so they stay right after edits.
 */
import { nearestData } from '../lib/site';
const data = nearestData().map(({ s, n, u, o }) => ({ s, n, u, o }));
---
<div class="nb" data-nb hidden>
  <div class="wrap nb__in">
    <span class="nb__text">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 21s7-6.4 7-11.5A7 7 0 0 0 5 9.5C5 14.6 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.5" fill="currentColor"/></svg>
      Closest to you: <strong data-nb-name></strong><span data-nb-mi></span>
    </span>
    <a class="nb__view" data-nb-link href="/locations/">View location</a>
    <button type="button" class="nb__x" data-nb-x aria-label="Dismiss">×</button>
  </div>
  <script type="application/json" data-nb-data set:html={JSON.stringify(data)} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-nb]').forEach((bar) => {
    let saved: { s: string; mi?: number } | null = null;
    try {
      saved = JSON.parse(localStorage.getItem('ti-nearest') || 'null');
      if (saved && localStorage.getItem('ti-nearest-dismissed') === saved.s) saved = null;
    } catch { saved = null; }
    const locs: { s: string; n: string; u: string; o: boolean }[] = JSON.parse(bar.querySelector('[data-nb-data]')?.textContent || '[]');
    const loc = saved && locs.find((l) => l.s === saved!.s);
    if (!loc) return;
    bar.querySelector('[data-nb-name]')!.textContent = loc.n + (loc.o ? '' : ' (coming soon)');
    if (saved?.mi != null) bar.querySelector('[data-nb-mi]')!.textContent = ` · about ${saved.mi} mi`;
    bar.querySelector<HTMLAnchorElement>('[data-nb-link]')!.href = loc.u;
    bar.hidden = false;
    bar.querySelector('[data-nb-x]')!.addEventListener('click', () => {
      try { localStorage.setItem('ti-nearest-dismissed', loc.s); } catch {}
      bar.hidden = true;
    });
  });
</script>

<style>
  .nb {
    background: var(--teal-soft);
    border-bottom: 1px solid var(--line);
    color: var(--navy);
    font-size: 0.95rem;
  }
  .nb__in {
    position: relative;
    padding-block: 9px;
    padding-right: 48px;
    line-height: 1.45;
  }
  .nb__text svg {
    display: inline-block;
    vertical-align: -3px;
    margin-right: 6px;
  }
  .nb__view {
    font-weight: 700;
    margin-left: 10px;
    white-space: nowrap;
  }
  .nb__x {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font: inherit;
    font-size: 1.4rem;
    line-height: 1;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--navy);
    cursor: pointer;
  }
  .nb__x:hover,
  .nb__x:focus-visible {
    background: rgb(11 45 91 / 8%);
  }
</style>
