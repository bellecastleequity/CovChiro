---
import Wordmark from './Wordmark.astro';
import { site, branches, branchName, branchPath, isOpen, isPlaceholder } from '../lib/site';
import PhoneLink from './PhoneLink.astro';
import { conditions } from '../lib/conditions';
import { ui, type Lang } from '../lib/i18n';
interface Props { city?: string; lang?: Lang }
const { city, lang = 'en' } = Astro.props;
const t = ui(lang);
// Spanish / Creole pages: the English page lists collapse to one "full site in English" link.
const en = lang === 'en';
const here = city ? branches.find((b) => b.city === city) : undefined;
const year = new Date().getFullYear();
// Social profiles from the content editor (Site → Social). A link only shows once its URL is set.
const handle = site.social.instagramHandle || '@therapyandinjury';
const social = [
  { key: 'youtube', label: 'YouTube', text: handle, url: site.social.youtube },
  { key: 'instagram', label: 'Instagram', text: handle, url: site.social.instagram },
  { key: 'facebook', label: 'Facebook', text: 'Facebook', url: site.social.facebook },
].filter((x) => !isPlaceholder(x.url));
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__grid">
      <div class="ftr__brand">
        <Wordmark city={city} reverse size="md" />
        <p class="ftr__phone">{t.mainLine} <PhoneLink /></p>
        <p class="ftr__blurb">{t.footBlurb}</p>
        {social.length > 0 && (
          <ul class="ftr__social" aria-label={t.followUs}>
            {social.map((x) => (
              <li>
                <a href={x.url} rel="noopener me" target="_blank">
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                    {x.key === 'youtube' && (<><rect x="1.5" y="4.5" width="21" height="15" rx="4.5" fill="currentColor" /><path d="M10 8.8v6.4l5.6-3.2z" fill="#0b2d5b" /></>)}
                    {x.key === 'instagram' && (<g fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" /></g>)}
                    {x.key === 'facebook' && (<path d="M13.5 21v-7.5H16l.4-3h-2.9V8.7c0-.9.3-1.5 1.6-1.5h1.5V4.5c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.3H8.2v3h2.5V21z" fill="currentColor" />)}
                  </svg>
                  <span><span class="sr-only">{x.label}: </span>{x.text}</span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      <nav aria-label="Locations">
        <h2 class="ftr__h">{t.locations}</h2>
        <ul>
          {branches.map((b) => (
            <li><a href={branchPath(b)}>{branchName(b)}</a>{!isOpen(b) && <span class="ftr__soon"> · {t.comingSoon}</span>}</li>
          ))}
        </ul>
        {!en && <p class="ftr__en"><a href="/" hreflang="en-US">{t.moreEnglish} →</a></p>}
      </nav>
      {en && <><nav aria-label="Conditions">
        <h2 class="ftr__h">Conditions</h2>
        <ul>
          {conditions.map((c) => <li><a href={`/conditions/${c.slug}/`}>{c.name}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Footer">
        <h2 class="ftr__h">Learn</h2>
        <ul>
          <li><a href="/auto-accident-injuries/">Auto Accident Injuries</a></li>
          <li><a href="/what-to-do-after-a-car-accident/">What to Do After a Car Accident</a></li>
          <li><a href="/services/">Services</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/patients/">Patient center</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav></>}
    </div>

    <div class="ftr__legal">
      <p><strong>{site.operatorLine}</strong> {t.licensed}</p>
      {here && !isPlaceholder(here.legalEntity) && <p>{branchName(here)} is operated by {here.legalEntity}.</p>}
      <p class="ftr__disclaimer">
        {t.disclaimer}
      </p>
      <p class="ftr__links">
        <a href="/privacy/">{t.privacy}</a>
        <a href="/accessibility/">{t.accessibility}</a>
        <span>© {year} {site.brandName}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--navy);
    color: #e6ecf3;
    padding-block: 64px 32px;
    font-size: 0.95rem;
  }
  .ftr a {
    color: var(--white);
    text-decoration-color: var(--teal);
  }
  .ftr__grid {
    display: grid;
    gap: 36px;
  }
  @media (min-width: 820px) {
    .ftr__grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
    }
  }
  .ftr__phone {
    margin: 18px 0 0;
    font-weight: 600;
    color: var(--white);
  }
  .ftr__phone :global(a) {
    color: var(--white);
    text-decoration-color: var(--teal);
  }
  .ftr__blurb {
    margin-top: 10px;
    max-width: 42ch;
    color: #c9d3de;
  }
  .ftr__social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-top: 18px !important;
  }
  .ftr__social li {
    margin: 0;
  }
  .ftr__social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--white);
    text-decoration: none;
    font-weight: 600;
    padding: 6px 12px 6px 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 8%);
  }
  .ftr__social a:hover,
  .ftr__social a:focus-visible {
    background: rgb(25 204 190 / 22%);
  }
  .ftr__social svg {
    color: var(--teal);
    flex: none;
  }
  .ftr__h {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 12px;
  }
  .ftr ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ftr li {
    margin-bottom: 8px;
  }
  .ftr__soon {
    color: #c9d3de;
  }
  .ftr__legal {
    margin-top: 44px;
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 15%);
    color: #c9d3de;
  }
  .ftr__legal p {
    margin-bottom: 6px;
  }
  .ftr__legal strong {
    color: var(--white);
    font-weight: 600;
  }
  .ftr__disclaimer {
    margin-top: 14px;
    font-size: 0.85rem;
    max-width: 90ch;
  }
  .ftr__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 16px;
    font-size: 0.875rem;
  }
</style>
