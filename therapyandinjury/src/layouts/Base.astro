---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import Attribution from '../components/Attribution.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import PipBanner from '../components/PipBanner.astro';
import CtaBand from '../components/CtaBand.astro';
import NearestBanner from '../components/NearestBanner.astro';
import AttorneyBand from '../components/AttorneyBand.astro';
import { site, abs, orgSchema, breadcrumbSchema, type Branch } from '../lib/site';
import { LANGS, langInfo, ui, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  city?: string;
  ctaHref?: string;
  schema?: Record<string, unknown> | (Record<string, unknown> | null)[] | null;
  /** [name, path] pairs after Home; adds BreadcrumbList JSON-LD. */
  breadcrumbs?: [string, string][];
  noindex?: boolean;
  /** Location for the mobile Call / Request / Directions bar (brand pages get a generic bar). */
  branch?: Branch;
  /** The page shows the attorney/auto-insurance banner itself (mid-page), so skip the one above the CTA. */
  attorneyInline?: boolean;
  /** Page language (en default; es and ht for the Spanish and Creole pages). */
  lang?: Lang;
  /** This page exists in all three languages (home, /es/, /ht/): adds hreflang links between them. */
  alternates?: boolean;
}
const { title, description, ogImage = '/og/default.png', ogType = 'website', city, ctaHref, schema, breadcrumbs, noindex = false, branch, attorneyInline = false, lang = 'en', alternates = false } = Astro.props;
const L = langInfo(lang);
const canonical = abs(Astro.url.pathname);
const pageSchemas = (Array.isArray(schema) ? schema : [schema]).filter(Boolean) as Record<string, unknown>[];
const schemas = [...orgSchema(), ...pageSchemas, ...(breadcrumbs ? [breadcrumbSchema(breadcrumbs)] : [])];
const { googleSiteVerification, bingSiteVerification } = site.seo;
---
<!doctype html>
<html lang={L.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && LANGS.map((x) => <link rel="alternate" hreflang={x.locale} href={abs(x.path)} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={abs('/')} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}
    <meta name="geo.region" content="US-FL" />
    <meta name="theme-color" content="#0B2D5B" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/brand/mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/favicon-180.png" />
    <link rel="alternate" type="application/rss+xml" title="Therapy & Injury blog" href="/blog/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={city ? `${city} Therapy & Injury` : site.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={city ? `${city} Therapy & Injury logo and tagline` : 'Therapy & Injury logo and tagline'} />
    <meta property="og:locale" content={L.og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(ogImage)} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <Analytics />
    <Attribution />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui(lang).skip}</a>
    <PipBanner branch={branch} lang={lang} />
    <Header city={city} ctaHref={ctaHref} lang={lang} />
    {!branch && !city && lang === 'en' && <NearestBanner />}
    <main id="main">
      <slot />
      {!attorneyInline && <AttorneyBand lang={lang} />}
      <CtaBand branch={branch} lang={lang} ctaHref={ctaHref} />
    </main>
    <Footer city={city} lang={lang} />
    <MobileActionBar branch={branch} lang={lang} ctaHref={ctaHref} />
  </body>
</html>
