---
import Base from '../layouts/Base.astro';
import LocationPicker from '../components/LocationPicker.astro';
---
<Base title="Page not found | Therapy & Injury" description="The page you were looking for could not be found." noindex>
  <section class="section">
    <div class="wrap nf">
      <img src="/brand/mark.svg" alt="" width="96" height="96" />
      <h1>We couldn’t find that page</h1>
      <p class="lede">It may have moved. Try one of these instead.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Home</a>
        <a class="btn btn--ghost" href="/locations/">All locations</a>
        <a class="btn btn--ghost" href="/auto-accident-injuries/">After a car accident</a>
      </div>
      <div class="nf__picker"><LocationPicker id="nf-picker" /></div>
    </div>
  </section>
</Base>
<style>
  .nf img {
    margin-bottom: 24px;
  }
  .nf__picker {
    margin-top: 32px;
  }
</style>
