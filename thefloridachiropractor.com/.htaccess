RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www-less canonical host (adjust/remove if you prefer www.)
RewriteCond %{HTTP_HOST} ^www\.thefloridachiropractor\.com$ [NC]
RewriteRule ^(.*)$ https://thefloridachiropractor.com/$1 [L,R=301]

Options -Indexes

# This account runs LiteSpeed Cache. Every API response is dynamic
# (availability, balances, document upload status, etc.) — nothing under
# /api/ should ever be served from cache, even if a future LSCache setting
# changes to cache more broadly by default.
<IfModule LiteSpeed>
  CacheDisable public /api/
</IfModule>
