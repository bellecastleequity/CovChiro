RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www-less canonical host (adjust/remove if you prefer www.)
RewriteCond %{HTTP_HOST} ^www\.thefloridachiropractor\.com$ [NC]
RewriteRule ^(.*)$ https://thefloridachiropractor.com/$1 [L,R=301]

Options -Indexes

# Browser-side hardening. HSTS is deliberately left out for now — add it
# only once HTTPS delivery is confirmed rock-solid, since a cached HSTS
# header can lock out visitors if TLS ever hiccups on this domain.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# This account runs LiteSpeed Cache. Every API response is dynamic
# (availability, balances, document upload status, etc.) — nothing under
# /api/ should ever be served from cache, even if a future LSCache setting
# changes to cache more broadly by default.
<IfModule LiteSpeed>
  CacheDisable public /api/
</IfModule>
